<resources>

    <style name="BottomNavStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemHorizontalTranslationEnabled">false</item>
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemIconSize">24dp</item>
        <item name="android:textSize">11sp</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:background">@drawable/bottom_nav_background</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Стиль для активного индикатора (фиолетовый овал) -->
    <style name="ActiveIndicatorStyle" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/purple_80</item>
        <item name="shapeAppearance">@style/ShapeAppearanceRounded</item>
        <item name="android:width">60dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="ShapeAppearanceRounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="BottomNavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:translationY">2dp</item>
    </style>

    <style name="AppTextField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="AppPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
