<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?colorSurfaceVariant"
    android:paddingBottom="60dp">

    <!-- Шапка -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Заказы для рецензирования"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/purple_80"
                android:gravity="center"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Контент -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Прогресс -->
        <ProgressBar
            android:id="@+id/progressReviewer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <!-- Пустое состояние -->
        <LinearLayout
            android:id="@+id/emptyBlockReviewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_orders"
                app:tint="@color/purple_40"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvEmptyTitleReviewer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Нет заказов для рецензии"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tvEmptySubtitleReviewer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Все заказы проверены или еще не поступили"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="8dp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Список заказов -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerReviewerOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="16dp"/>

    </FrameLayout>

</LinearLayout>